{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:spec-audit:review-check:1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "review_id": {
      "type": "string",
      "minLength": 1
    },
    "review_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "basis_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "context_ref": {
      "type": "string",
      "minLength": 1
    },
    "conclusion": {
      "enum": [
        "confirmed",
        "changes_required"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "snapshot_id",
    "review_id",
    "review_sha256",
    "basis_sha256",
    "reviewer",
    "context_ref",
    "conclusion",
    "summary",
    "limitations"
  ]
}
