{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:spec-audit:external-result:4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool_version",
    "scope",
    "run_id",
    "snapshot_id",
    "accepted_head",
    "basis",
    "paths",
    "source_retention",
    "report_basis",
    "current_freshness",
    "report_ref",
    "decision_ref"
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "tool_version": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "accepted_head": {
      "type": "string"
    },
    "basis": {
      "type": "object",
      "required": [
        "project",
        "corpus",
        "scope",
        "spec_version",
        "manifest_sha256",
        "input_sha256",
        "code_basis",
        "freshness"
      ]
    },
    "paths": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "source_retention": {
      "enum": [
        "archive",
        "citations"
      ]
    },
    "report_basis": {
      "enum": [
        "saved_run",
        "historical_publication"
      ]
    },
    "current_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "source_availability",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "fresh",
            "stale",
            "unchecked"
          ]
        },
        "source_availability": {
          "enum": [
            "available",
            "released",
            "unavailable"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "report_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "const": "report.json"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "decision_ref": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "pointer"
          ],
          "properties": {
            "path": {
              "const": "report.json"
            },
            "pointer": {
              "const": "/host_review"
            }
          }
        }
      ]
    }
  }
}
