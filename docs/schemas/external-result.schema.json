{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:spec-audit:external-result:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool_version",
    "scope",
    "run_id",
    "snapshot_id",
    "accepted_head",
    "basis",
    "decision",
    "report",
    "paths"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "tool_version": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "accepted_head": {
      "type": "string"
    },
    "basis": {
      "type": "object",
      "required": [
        "project",
        "corpus",
        "scope",
        "spec_version",
        "manifest_sha256",
        "input_sha256",
        "code_basis",
        "freshness"
      ]
    },
    "decision": {
      "type": [
        "object",
        "null"
      ]
    },
    "report": {
      "type": "object",
      "required": [
        "run_id",
        "snapshot_id",
        "requirements",
        "host_reconciliation_required",
        "limitations",
        "sources"
      ]
    },
    "paths": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
