{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:spec-audit:source-manifest:1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "spec_version": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "corpus": {
      "type": "string",
      "minLength": 1
    },
    "line": {
      "type": [
        "string",
        "null"
      ]
    },
    "previous_spec_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "sha256"
      ]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
          },
          "role": {
            "enum": [
              "normative",
              "reference",
              "archive"
            ]
          },
          "export": {
            "type": "boolean"
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 33554432
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "origin": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "trucker"
                  },
                  "project_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "document_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "revision_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "file_version_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "source_url": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "kind",
                  "project_id",
                  "document_id",
                  "revision_id",
                  "file_version_id",
                  "source_url"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "git"
                  },
                  "repository": {
                    "type": "string",
                    "minLength": 1
                  },
                  "commit": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "repository",
                  "commit",
                  "path"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "snapshot"
                  },
                  "snapshot_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "snapshot_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "snapshot_id",
                  "snapshot_sha256",
                  "path"
                ]
              }
            ]
          }
        },
        "required": [
          "path",
          "role",
          "export",
          "media_type",
          "size_bytes",
          "sha256",
          "origin"
        ]
      }
    },
    "file_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 25000
    }
  },
  "required": [
    "schema_version",
    "spec_version",
    "project",
    "corpus",
    "line",
    "previous_spec_version",
    "profile",
    "files",
    "file_count"
  ]
}
