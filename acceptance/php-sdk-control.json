{
  "version": 1,
  "purpose": "Frozen before PHP/Laravel SDK code. Semantic expectations for REQ-SA-031...034 derived from docs/tool-spec.md §17 and docs/php-sdk-contract.md, not from exporter output. Independent synthetic fixtures (acceptance/php-sdk/plain, acceptance/php-sdk/laravel) are the only acceptance basis; a pilot project is a debugging environment, never an expectation source. Runtime negatives of the Docker mock (slow, huge_output, exit_2, empty_stdout, setup_fails) live in Go tables, not here.",
  "boundaries": [
    "Facts are hints: no case may treat a resolved target as proof of requirement compliance or assertion relevance.",
    "Expectations are not rewritten to match analyzer behaviour; a mismatch becomes a documented limitation.",
    "No project names, paths or IDs of any pilot; fixture namespaces are Demo\\ (plain) and App\\ (synthetic Laravel).",
    "Exit code 1 of phpstan analyse with the specAudit.envelope message is success; exit 0 means the exporter did not run.",
    "State bytes of a run must be unchanged after any rejected php-typed; no artifact is written on rejection."
  ],
  "fixtures": {
    "plain": {
      "profile": "php",
      "root": "acceptance/php-sdk/plain",
      "namespace": "Demo\\",
      "tests_namespace": "Tests\\"
    },
    "laravel": {
      "profile": "laravel",
      "root": "acceptance/php-sdk/laravel",
      "namespace": "App\\"
    }
  },
  "cases": [
    {
      "id": "same_name_methods",
      "requirement": "REQ-SA-031",
      "kind": "positive",
      "fixture": "plain",
      "scenario": "Demo\\FileStore::save and Demo\\DbStore::save share a name. A call $fileStore->save() where $fileStore is typed Demo\\FileStore.",
      "expect": {
        "syntax": "Expr_MethodCall",
        "name": "save",
        "resolution": "resolved",
        "origin": "phpstan",
        "targets": [
          {
            "class": "Demo\\FileStore",
            "method": "save",
            "file": "src/FileStore.php",
            "line_positive": true,
            "interface": false,
            "native": false
          }
        ],
        "not_targets": [
          {
            "class": "Demo\\DbStore",
            "method": "save"
          }
        ]
      }
    },
    {
      "id": "inheritance_parent_target",
      "requirement": "REQ-SA-031",
      "kind": "positive",
      "fixture": "plain",
      "scenario": "Demo\\UserRepository extends Demo\\BaseRepository; find() is declared only in the parent. Call $userRepository->find(1).",
      "expect": {
        "resolution": "resolved",
        "targets": [
          {
            "class": "Demo\\BaseRepository",
            "method": "find",
            "file": "src/BaseRepository.php",
            "line_positive": true
          }
        ],
        "not_targets": [
          {
            "class": "Demo\\UserRepository",
            "method": "find"
          }
        ]
      }
    },
    {
      "id": "interface_without_impl",
      "requirement": "REQ-SA-031",
      "kind": "positive",
      "fixture": "plain",
      "scenario": "Demo\\Contracts\\Notifier is an interface with no implementation in the fixture. Call $notifier->notify() with $notifier typed as the interface.",
      "expect": {
        "resolution": "resolved",
        "targets": [
          {
            "class": "Demo\\Contracts\\Notifier",
            "method": "notify",
            "file": "src/Contracts/Notifier.php",
            "interface": true
          }
        ],
        "forbidden": "any target whose class is not the interface (no invented implementation)"
      }
    },
    {
      "id": "dynamic_name",
      "requirement": "REQ-SA-031",
      "kind": "positive",
      "fixture": "plain",
      "scenario": "Call $store->$method() with a variable method name.",
