    {
      "id": "facade_static",
      "requirement": "REQ-SA-031",
      "kind": "positive",
      "fixture": "laravel",
      "scenario": "Code calls Cache::remember(...) through the Illuminate facade (facade class carries @method docblocks).",
      "expect": {
        "name": "remember",
        "resolution_in": [
          "virtual",
          "resolved"
        ],
        "origin_in": [
          "phpstan",
          "larastan"
        ],
        "forbidden": "resolved target pointing to a file under app/; a virtual target must have file '' and line 0",
        "limitation": "facades with @method docblocks resolve as virtual/phpstan (annotation), not as the underlying class method; spike 2026-09-16 confirmed on a real Laravel project; documented, not corrected later by editing this file"
      }
    },
